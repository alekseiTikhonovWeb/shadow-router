# Copy to .env and fill in the values:  cp .env.example .env
# Never commit .env (gitignored). Secrets live here, at runtime only.

# One comma-separated key list per provider; gen_config.py expands it into the LiteLLM config (see litellm/catalog.yaml). Empty = provider skipped.
OPENAI_KEYS=          # sk-a,sk-b,sk-c   -> ChatGPT / Codex tabs
GEMINI_KEYS=          # AIza-1,AIza-2,... -> Gemini tab
ANTHROPIC_KEYS=       # sk-ant-...        -> Claude tab
XAI_KEYS=             # xai-...           -> Grok tab
DEEPSEEK_KEYS=        # sk-...            -> DeepSeek tab
# Markup over cost (catalog.yaml prices x MARKUP).
MARKUP=1.0

# LiteLLM
# Admin key (sk-...). Generate: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-CHANGE_ME
# LiteLLM's own Postgres (host = the litellm-db compose service).
DATABASE_URL=postgresql://llmproxy:CHANGE_ME@litellm-db:5432/litellm
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm
# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
LITELLM_BASE_URL=http://litellm:4000/v1

# LibreChat (UI only; its own balance is off)
MONGO_URI=mongodb://mongodb:27017/LibreChat
ALLOW_REGISTRATION=true
SEARCH=false
CHECK_BALANCE=false
# Encryption / sessions: CREDS_KEY = 64 hex, CREDS_IV = 32 hex, JWT_* = any long random string.
CREDS_KEY=CHANGE_ME_64_HEX
CREDS_IV=CHANGE_ME_32_HEX
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# LiteLLM virtual key for LibreChat; create it after the first start (README).
LITELLM_USER_KEY=

# Backend
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=user_accounts
SUPABASE_PAYMENTS_TABLE=payments
START_BUDGET=0
DEFAULT_RPM_LIMIT=60
DEFAULT_TPM_LIMIT=150000
DEFAULT_MODELS=gemini-flash,gemini-pro,gpt-4o-mini,gpt-5.5,gpt-5.5-pro

# LibreChat <-> Logto SSO
# App ID / Secret from the Logto "Traditional Web" application created for LibreChat.
# Prod (Railway, librechat service): https://chat.shadowrouter.ca for both DOMAIN_* vars.
DOMAIN_SERVER=http://localhost:3080
DOMAIN_CLIENT=http://localhost:3080
OPENID_ISSUER=https://<your-tenant>.logto.app/oidc
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE=openid profile email
OPENID_SESSION_SECRET=CHANGE_ME
OPENID_BUTTON_LABEL=Continue with ShadowRouter
# LibreChat branding (header / footer / help link); set in the librechat Railway Variables.
APP_TITLE=ShadowRouter
CUSTOM_FOOTER=AI can make mistakes. Verify important info.
HELP_AND_FAQ_URL=https://shadowrouter.ca/#faq

# Backend control-plane auth
INTERNAL_API_TOKEN=CHANGE_ME

# Logto webhook signing key (Logto -> Webhooks -> Signing key)
LOGTO_WEBHOOK_SIGNING_KEY=CHANGE_ME

# Logto machine-to-machine app for the Management API (synthetic emails, account deletion).
LOGTO_ENDPOINT=https://<your-tenant>.logto.app
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=
SYNTHETIC_EMAIL_DOMAIN=nomail.shadowrouter.ca

# NOWPayments crypto top-ups
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# Prod: PUBLIC_BASE_URL = the backend's public address; PORTAL_* = https://shadowrouter.ca/api-access and /billing.
PUBLIC_BASE_URL=http://localhost:8088
PORTAL_SUCCESS_URL=http://localhost:3000/api-access
PORTAL_CANCEL_URL=http://localhost:3000/billing
