# Copy to .env.local and fill in

# Logto (Next.js application). endpoint / appId are not secret; appSecret / cookieSecret are.
LOGTO_ENDPOINT=https://<your-tenant>.logto.app/
LOGTO_APP_ID=CHANGE_ME
LOGTO_APP_SECRET=CHANGE_ME            # App Secret of the Logto Next.js application
LOGTO_COOKIE_SECRET=CHANGE_ME_32_HEX  # any random string: openssl rand -hex 16
BASE_URL=http://localhost:3000

# Backend (control plane) for the dashboard
BACKEND_URL=http://localhost:8088
INTERNAL_API_TOKEN=CHANGE_ME

# Optional overrides of the app/lib/urls.ts defaults, for domain transitions only.
# NEXT_PUBLIC_CHAT_URL=https://chat.shadowrouter.ca
# NEXT_PUBLIC_LITELLM_URL=https://api.shadowrouter.ca/v1
# NEXT_PUBLIC_SUPPORT_EMAIL=support@wasd.digital
# CANONICAL_HOST=shadowrouter.ca      # middleware: where old portal hosts get 308-redirected
